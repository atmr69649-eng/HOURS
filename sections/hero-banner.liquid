{% comment %}
  sections/hero-banner.liquid
  High-impact editorial hero — supports image/video, gradient fallback
{% endcomment %}

{% assign has_media = false %}
{% if section.settings.hero_image != blank %}{% assign has_media = true %}{% endif %}

<section class="hero" aria-label="Hero banner">

  <!-- Media / Fallback -->
  <div class="hero-media" aria-hidden="true">
    {% if section.settings.hero_video_url != blank %}
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        style="width:100%;height:100%;object-fit:cover;">
        <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
      </video>
    {% elsif has_media %}
      {{
        section.settings.hero_image
        | image_url: width: 1600
        | image_tag:
          class: 'hero-bg-img',
          style: 'width:100%;height:100%;object-fit:cover;',
          alt: section.settings.hero_image.alt | default: 'HORUS',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '375, 640, 960, 1280, 1600'
      }}
    {% else %}
      <!-- Gradient fallback -->
      <div class="hero-gradient-bg" aria-hidden="true"></div>
      <div class="hero-grid" aria-hidden="true"></div>
    {% endif %}
  </div>

  <!-- Content -->
  <div class="hero-content">
    <div style="max-width:{{ section.settings.content_max_width }}px;">

      {% if section.settings.eyebrow != blank %}
        <p class="hero-eyebrow" aria-label="Collection tag">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h1 class="hero-title">
        {% if section.settings.title_line_1 != blank %}
          {{ section.settings.title_line_1 }}
          <br>
        {% endif %}
        {% if section.settings.title_line_2 != blank %}
          <span class="hero-title-accent">{{ section.settings.title_line_2 }}</span>
        {% endif %}
      </h1>

      {% if section.settings.subtitle != blank %}
        <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="hero-cta">
        {% if section.settings.cta_label != blank %}
          <a
            href="{{ section.settings.cta_url | default: routes.root_url }}"
            class="btn btn-gold"
            aria-label="{{ section.settings.cta_label }}">
            {{ section.settings.cta_label }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.cta_secondary_label != blank %}
          <a
            href="{{ section.settings.cta_secondary_url | default: routes.root_url }}"
            class="btn btn-outline"
            aria-label="{{ section.settings.cta_secondary_label }}">
            {{ section.settings.cta_secondary_label }}
          </a>
        {% endif %}
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll" aria-hidden="true">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "hero_video_url",
      "label": "Background Video URL (.mp4)",
      "info": "Hosted video URL. Takes priority over image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 60
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Tag Line",
      "default": "New Collection — SS 2025"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Heading Line 1",
      "default": "TIMELESS"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Heading Line 2 (Accent)",
      "default": "MEETS NOW"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Unisex staples born from vintage heritage reimagined with a modern edge. Premium fabrics made for today."
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Content Max Width",
      "default": 580
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
