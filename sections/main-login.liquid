{% comment %}
  sections/main-login.liquid
  Native Shopify Legacy Customer Login & Password Recovery section.
  Works with or without JavaScript (CSS :target + progressive toggle).
{% endcomment %}

<section
  id="MainLogin-{{ section.id }}"
  class="customer-section section-spacing"
  data-customer-login
  aria-label="{{ 'customer.login_page.title' | t }}">
  <div class="container customer-auth-container">

    <!-- Password Recovery Panel (#recover) -->
    <div id="recover" class="horus-form-card customer-recover-panel" data-recover-panel>
      <h1 class="customer-auth-title">{{ 'customer.recover_password.title' | t }}</h1>
      <p class="horus-form-subheading">{{ 'customer.recover_password.subtext' | t }}</p>

      {% form 'recover_customer_password', class: 'horus-form' %}
        {%- assign recover_success = form.posted_successfully? -%}
        {% if form.errors %}
          <div class="form-status form-status-error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-field">
          <label for="RecoverEmail" class="form-label">
            {{ 'customer.login_page.email' | t }} <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="RecoverEmail"
            name="email"
            class="form-input"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            aria-required="true"
            placeholder="{{ 'customer.login_page.email' | t }}">
        </div>

        <div class="horus-form-actions customer-auth-actions">
          <button type="submit" class="btn btn-gold btn-full">
            {{ 'customer.login_page.submit' | t }}
          </button>
          <a href="#login" class="customer-text-link" data-login-toggle>
            {{ 'customer.login_page.cancel' | t }}
          </a>
        </div>
      {% endform %}
    </div>

    <!-- Sign In Panel (#login) -->
    <div id="login" class="horus-form-card customer-login-panel" data-login-panel>
      <h1 class="customer-auth-title">{{ 'customer.login_page.title' | t }}</h1>

      {% if recover_success == true %}
        <div class="form-status form-status-success" role="status" tabindex="-1" autofocus>
          <span>{{ 'customer.recover_password.success' | t }}</span>
        </div>
      {% endif %}

      {% form 'customer_login', class: 'horus-form' %}
        {% if form.errors %}
          <div class="form-status form-status-error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-field">
          <label for="CustomerEmail" class="form-label">
            {{ 'customer.login_page.email' | t }} <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="CustomerEmail"
            name="customer[email]"
            class="form-input"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            aria-required="true"
            placeholder="{{ 'customer.login_page.email' | t }}">
        </div>

        {% if form.password_needed %}
          <div class="form-field">
            <div class="form-label-row">
              <label for="CustomerPassword" class="form-label">
                {{ 'customer.login_page.password' | t }} <span class="form-required" aria-hidden="true">*</span>
              </label>
              <a href="#recover" class="customer-text-link" data-recover-toggle>
                {{ 'customer.login_page.forgot_password' | t }}
              </a>
            </div>
            <input
              type="password"
              id="CustomerPassword"
              name="customer[password]"
              class="form-input"
              autocomplete="current-password"
              required
              aria-required="true"
              placeholder="{{ 'customer.login_page.password' | t }}">
          </div>
        {% endif %}

        <div class="horus-form-actions customer-auth-actions">
          <button type="submit" class="btn btn-gold btn-full">
            {{ 'customer.login_page.sign_in' | t }}
          </button>
          <a href="{{ routes.account_register_url }}" class="customer-text-link">
            {{ 'customer.login_page.create_account' | t }}
          </a>
        </div>
      {% endform %}

      {% if shop.checkout.guest_login %}
        <div class="divider divider-gold customer-divider"></div>
        <h2 class="customer-guest-heading">{{ 'customer.login_page.guest_title' | t }}</h2>
        {% form 'guest_login' %}
          <button type="submit" class="btn btn-outline btn-full">
            {{ 'customer.login_page.guest_continue' | t }}
          </button>
        {% endform %}
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Customer Login",
  "tag": "section",
  "class": "main-login-wrapper",
  "settings": []
}
{% endschema %}
