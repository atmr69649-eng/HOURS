{% comment %}
  sections/collapsible-content.liquid
  Reusable accessible accordion section (FAQ / Care / Info) powered by
  native <details>/<summary> and Shopify Theme Editor blocks.
  Zero invented policies or answers.
{% endcomment %}

{%- liquid
  assign has_rows = false
  for block in section.blocks
    if block.settings.heading != blank
      assign has_rows = true
      break
    endif
  endfor
-%}

{% if has_rows or request.design_mode %}
  <section
    id="CollapsibleContent-{{ section.id }}"
    class="faq-section"
    aria-label="{{ section.settings.heading | default: 'Frequently Asked Questions' | escape }}">
    <div class="container page-container page-container--narrow">

      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="faq-header">
          {% if section.settings.heading != blank %}
            <h2 class="page-block-heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="horus-form-subheading">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if has_rows %}
        <div class="pdp-blocks faq-list">
          {% for block in section.blocks %}
            {% if block.settings.heading != blank %}
              <details
                class="pdp-accordion"
                {% if block.settings.open_by_default %}open{% endif %}
                {{ block.shopify_attributes }}>
                <summary class="pdp-accordion-trigger">
                  <span>{{ block.settings.heading | escape }}</span>
                  <svg class="pdp-accordion-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="pdp-accordion-body rte" data-rte-tables>
                  {{ block.settings.row_content }}
                  {% if block.settings.page != blank %}
                    {{ block.settings.page.content }}
                  {% endif %}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      {% elsif request.design_mode %}
        <div class="horus-form-card">
          <p class="horus-form-subheading" style="margin:0;">
            Add FAQ rows using the "Question / Row" blocks in the Theme Editor, or enter content directly in the Shopify Admin page body.
          </p>
        </div>
      {% endif %}

    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Collapsible Content / FAQ",
  "tag": "section",
  "class": "collapsible-content-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Optional Subheading"
    }
  ],
  "blocks": [
    {
      "type": "collapsible_row",
      "name": "Question / Row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Question / Heading"
        },
        {
          "type": "richtext",
          "id": "row_content",
          "label": "Answer / Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Or load content from page"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible Content / FAQ"
    }
  ]
}
{% endschema %}
