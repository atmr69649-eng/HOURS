{% comment %}
  sections/collection-tabs.liquid
  Horizontal-swipeable category filter tabs + product grid
{% endcomment %}

{%- liquid
  assign tab_all_label   = 'All'
  assign tab_items_limit = section.settings.items_per_page | default: 8

  # Smart context: use the current collection page if available, else fall back to collections.all
  if collection and collection.handle != blank
    assign source_collection = collection
  else
    assign source_collection = collections.all
  endif

  # Build tab list from blocks; fall back to hardcoded defaults
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
-%}

<section
  id="collection-tabs"
  class="collection-tabs-section section-spacing"
  aria-label="Product categories">
  <div class="container">

    <!-- Section Header -->
    <div class="section-header">
      <div>
        <div class="section-title-line">
          <h2 class="section-title">{{ section.settings.section_title | default: 'The Drop' }}</h2>
        </div>
      </div>
      {% if section.settings.show_view_all %}
        <a href="{{ section.settings.view_all_url | default: routes.root_url }}" class="section-link" aria-label="View all products">
          View All →
        </a>
      {% endif %}
    </div>

    <!-- Tab Pills -->
    <div class="tabs-scroll" role="tablist" aria-label="Product categories">
      <button
        class="tab-pill active"
        data-tab="all"
        role="tab"
        aria-selected="true"
        aria-controls="products-grid">
        {{ tab_all_label }}
        <span class="tab-pill-count" aria-label="{{ source_collection.products_count }} products">
          {{ source_collection.products_count | default: '∞' }}
        </span>
      </button>

      {% if has_blocks %}
        {% for block in section.blocks %}
          {% if block.type == 'category_tab' %}
            {%- assign tab_collection = collections[block.settings.collection] -%}
            <button
              class="tab-pill"
              data-tab="{{ block.settings.collection | handle }}"
              role="tab"
              aria-selected="false"
              {{ block.shopify_attributes }}>
              {{ block.settings.label | default: tab_collection.title }}
              {% if tab_collection.products_count > 0 %}
                <span class="tab-pill-count">{{ tab_collection.products_count }}</span>
              {% endif %}
            </button>
          {% endif %}
        {% endfor %}
      {% else %}
        <!-- Default tabs if no blocks configured -->
        <button class="tab-pill" data-tab="hoodies" role="tab" aria-selected="false">Hoodies</button>
        <button class="tab-pill" data-tab="t-shirts" role="tab" aria-selected="false">T-Shirts</button>
        <button class="tab-pill" data-tab="sweatpants" role="tab" aria-selected="false">Sweatpants</button>
        <button class="tab-pill" data-tab="accessories" role="tab" aria-selected="false">Accessories</button>
      {% endif %}
    </div>

    <!-- Products Grid -->
    <div
      id="products-grid"
      class="products-grid"
      role="tabpanel"
      aria-label="Products">

      {%- assign all_products = source_collection.products -%}

      {% if all_products.size > 0 %}
        {% for product in all_products limit: tab_items_limit %}
          <div
            class="product-item animate-fade-in"
            data-category="{{ product.type | handle }}"
            style="animation-delay: {{ forloop.index0 | times: 40 }}ms;">
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Placeholder skeleton cards -->
        {% for i in (1..8) %}
          <div class="product-item" data-category="{% cycle 'hoodies', 't-shirts', 'sweatpants', 'accessories' %}">
            <div class="product-card">
              <div class="card-image-wrap loading" style="aspect-ratio:3/4;"></div>
              <div class="card-info">
                <div style="height:14px;background:var(--color-surface-3);border-radius:4px;margin-bottom:8px;"></div>
                <div style="height:18px;background:var(--color-surface-3);border-radius:4px;width:60%;"></div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Load More -->
    {% if section.settings.show_view_all and all_products.size > tab_items_limit %}
      <div class="load-more-wrap">
        <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="btn btn-outline">
          Load More
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Collection Tabs",
  "tag": "section",
  "class": "collection-tabs-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "The Drop"
    },
    {
      "type": "range",
      "id": "items_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "'View All' URL"
    }
  ],
  "blocks": [
    {
      "type": "category_tab",
      "name": "Category Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "info": "Leave blank to use collection title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [
        { "type": "category_tab", "settings": { "label": "Hoodies" } },
        { "type": "category_tab", "settings": { "label": "T-Shirts" } },
        { "type": "category_tab", "settings": { "label": "Sweatpants" } }
      ]
    }
  ]
}
{% endschema %}
