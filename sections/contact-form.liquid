{% comment %}
  sections/contact-form.liquid
  Native Shopify {% form 'contact' %} section matching the HORUS design system.
  Zero hardcoded email addresses, phone numbers, or addresses.
{% endcomment %}

<section
  id="ContactFormSection-{{ section.id }}"
  class="contact-section"
  aria-label="{{ section.settings.heading | default: 'Contact' | escape }}">
  <div class="container page-container page-container--narrow">
    <div class="horus-form-card">
      {% if section.settings.heading != blank %}
        <h2 class="horus-form-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="horus-form-subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      {% form 'contact', id: 'ContactForm', class: 'horus-form' %}
        {% if form.posted_successfully? %}
          <div class="form-status form-status-success" role="status" tabindex="-1" autofocus>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{{ 'templates.contact.form.post_success' | t }}</span>
          </div>
        {% elsif form.errors %}
          <div class="form-status form-status-error" role="alert" tabindex="-1" autofocus>
            <p class="form-status-title">{{ 'templates.contact.form.error_heading' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="horus-form-grid">
          <div class="form-field">
            <label for="ContactForm-name-{{ section.id }}" class="form-label">
              {{ 'templates.contact.form.name' | t }}
            </label>
            <input
              type="text"
              id="ContactForm-name-{{ section.id }}"
              name="contact[name]"
              class="form-input"
              autocomplete="name"
              value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
              placeholder="{{ 'templates.contact.form.name' | t }}">
          </div>

          <div class="form-field">
            <label for="ContactForm-email-{{ section.id }}" class="form-label">
              {{ 'templates.contact.form.email' | t }} <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="ContactForm-email-{{ section.id }}"
              name="contact[email]"
              class="form-input"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              aria-required="true"
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
              placeholder="{{ 'templates.contact.form.email' | t }}">
          </div>
        </div>

        <div class="form-field">
          <label for="ContactForm-phone-{{ section.id }}" class="form-label">
            {{ 'templates.contact.form.phone' | t }}
          </label>
          <input
            type="tel"
            id="ContactForm-phone-{{ section.id }}"
            name="contact[phone]"
            class="form-input"
            autocomplete="tel"
            pattern="[0-9\-+\s()]*"
            value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
            placeholder="{{ 'templates.contact.form.phone' | t }}">
        </div>

        <div class="form-field">
          <label for="ContactForm-body-{{ section.id }}" class="form-label">
            {{ 'templates.contact.form.comment' | t }} <span class="form-required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="ContactForm-body-{{ section.id }}"
            name="contact[body]"
            class="form-input form-textarea"
            rows="6"
            required
            aria-required="true"
            placeholder="{{ 'templates.contact.form.comment' | t }}">{{- form.body -}}</textarea>
        </div>

        <div class="horus-form-actions">
          <button type="submit" class="btn btn-gold">
            {{ 'templates.contact.form.send' | t }}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "contact-form-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Send a Message"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Optional intro note"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
