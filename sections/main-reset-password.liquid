{% comment %}
  sections/main-reset-password.liquid
  Native Shopify Legacy Customer Password Reset section.
{% endcomment %}

<section
  id="MainResetPassword-{{ section.id }}"
  class="customer-section section-spacing"
  aria-label="{{ 'customer.reset_password.title' | t }}">
  <div class="container customer-auth-container">
    <div class="horus-form-card">
      <h1 class="customer-auth-title">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="horus-form-subheading">
        {{ 'customer.reset_password.subtext' | t }}
      </p>

      {% form 'reset_customer_password', class: 'horus-form' %}
        {% if form.errors %}
          <div class="form-status form-status-error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-field">
          <label for="ResetPassword" class="form-label">
            {{ 'customer.reset_password.password' | t }} <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="password"
            id="ResetPassword"
            name="customer[password]"
            class="form-input"
            autocomplete="new-password"
            required
            aria-required="true">
        </div>

        <div class="form-field">
          <label for="PasswordConfirmation" class="form-label">
            {{ 'customer.reset_password.password_confirm' | t }} <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="password"
            id="PasswordConfirmation"
            name="customer[password_confirmation]"
            class="form-input"
            autocomplete="new-password"
            required
            aria-required="true">
        </div>

        <div class="horus-form-actions">
          <button type="submit" class="btn btn-gold btn-full">
            {{ 'customer.reset_password.submit' | t }}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "tag": "section",
  "class": "main-reset-password-wrapper",
  "settings": []
}
{% endschema %}
