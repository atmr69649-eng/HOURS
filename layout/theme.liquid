<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0B0B0B">

  <title>
    {{ page_title }}
    {%- if current_tags %} &mdash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {%- if current_page != 1 %} &mdash; Page {{ current_page }}{% endif %}
    {%- assign store_brand_name = 'HORUS' -%}
    {%- unless page_title contains store_brand_name %} &mdash; {{ store_brand_name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name"   content="HORUS">
  <meta property="og:url"         content="{{ canonical_url }}">
  <meta property="og:title"       content="{{ page_title | escape }}">
  <meta property="og:type"        content="website">
  {% if page_image %}
    <meta property="og:image"       content="https:{{ page_image | image_url }}">
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {% endif %}
  {% if page_description %}
    <meta property="og:description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card"  content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Google Fonts: Bebas Neue (Poster) + Classical Serif (Cinzel) + Display + Body -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,900&family=Bebas+Neue&family=Cinzel:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,900&family=Bebas+Neue&family=Cinzel:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Favicon -->
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {% else %}
    <link rel="icon" type="image/jpeg" href="{{ 'horus-logo.jpg' | asset_url }}">
  {% endif %}

  <!-- Theme Stylesheet -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- Shopify required head content -->
  {{ content_for_header }}
</head>

<body id="shopify-section-body" class="template-{{ template.name | handle }}">

  <!-- Skip to content (accessibility) -->
  <a href="#main-content" class="sr-only" style="
    position:fixed;top:var(--space-4);left:var(--space-4);z-index:9999;
    background:var(--color-gold);color:#0B0B0B;
    padding:var(--space-3) var(--space-5);border-radius:var(--radius-md);
    font-weight:700;letter-spacing:0.05em;text-transform:uppercase;
    transform:translateY(-100%);transition:transform 0.2s;
    ">
    Skip to content
  </a>

  <!-- Site Header -->
  {% section 'header' %}

  <!-- Mobile Navigation -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
    {% for link in linklists[settings.main_menu_handle].links %}
      <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
    {% endfor %}
    <div style="margin-top:auto;padding-top:var(--space-8);">
      <div class="divider-gold divider" style="margin-bottom:var(--space-6);"></div>
      {% for link in linklists[settings.secondary_menu_handle].links %}
        <a href="{{ link.url }}" class="mobile-nav-link" style="font-size:var(--text-xl);color:var(--color-text-muted);">{{ link.title }}</a>
      {% endfor %}
    </div>
  </nav>

  <!-- Cart Overlay -->
  <div id="cart-overlay" class="cart-overlay" aria-hidden="true"></div>

  <!-- Cart Drawer -->
  {% render 'cart-drawer' %}

  <!-- Main Content -->
  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Site Footer -->
  {% section 'footer' %}

  <!-- Toast Notifications (injected by JS) -->

  <!-- Theme JS -->
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  <!-- Shopify analytics / checkout JS -->
  {% if settings.enable_predictive_search %}
    <script>
      window.HorusPredictiveSearch = {
        resources: {
          type: ['product', 'collection'],
          limit: 4,
          options: { unavailable_products: 'last', fields: ['title', 'product_type', 'variants.title', 'vendor'] }
        }
      };
    </script>
  {% endif %}

</body>
</html>
