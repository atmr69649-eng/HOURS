<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0B0B0B">

  <title>
    {{ page_title }}
    {%- if current_tags %} &mdash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {%- if current_page != 1 %} &mdash; Page {{ current_page }}{% endif %}
    {%- assign store_brand_name = 'HORUS' -%}
    {%- unless page_title contains store_brand_name %} &mdash; {{ store_brand_name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name"   content="HORUS">
  <meta property="og:url"         content="{{ canonical_url }}">
  <meta property="og:title"       content="{{ page_title | escape }}">
  <meta property="og:type"        content="website">
  {% if page_image %}
    <meta property="og:image"       content="https:{{ page_image | image_url }}">
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {% endif %}
  {% if page_description %}
    <meta property="og:description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card"  content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Google Fonts: Bebas Neue (Poster) + Classical Serif (Cinzel) + Display + Body -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,900&family=Bebas+Neue&family=Cinzel:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,900&family=Bebas+Neue&family=Cinzel:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Favicon -->
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {% else %}
    <link rel="icon" type="image/jpeg" href="{{ 'horus-logo.jpg' | asset_url }}">
  {% endif %}

  <!-- Theme Stylesheet -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- Shopify required head content -->
  {{ content_for_header }}
</head>

<body id="shopify-section-body" class="template-{{ template.name | handle }}">

  <!-- Skip to content (accessibility) -->
  <a href="#main-content" class="sr-only" style="
    position:fixed;top:var(--space-4);left:var(--space-4);z-index:9999;
    background:var(--color-gold);color:#0B0B0B;
    padding:var(--space-3) var(--space-5);border-radius:var(--radius-md);
    font-weight:700;letter-spacing:0.05em;text-transform:uppercase;
    transform:translateY(-100%);transition:transform 0.2s;
    ">
    Skip to content
  </a>

  <!-- Site Header -->
  {% section 'header' %}

  <!-- Mobile Navigation -->
  {%- liquid
    assign mobile_main_links = settings.main_menu_handle.links
    if mobile_main_links == blank and settings.main_menu_handle != blank
      assign mobile_main_links = linklists[settings.main_menu_handle].links
    endif
    assign mobile_secondary_links = settings.secondary_menu_handle.links
    if mobile_secondary_links == blank and settings.secondary_menu_handle != blank
      assign mobile_secondary_links = linklists[settings.secondary_menu_handle].links
    endif
  -%}
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
    {% for link in mobile_main_links %}
      <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
    {% endfor %}
    <div style="margin-top:auto;padding-top:var(--space-8);">
      <div class="divider-gold divider" style="margin-bottom:var(--space-6);"></div>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="mobile-nav-link mobile-nav-account">
          {% if customer %}
            {{ 'customer.account.title' | t }}
          {% else %}
            {{ 'customer.log_in' | t }}
          {% endif %}
        </a>
      {% endif %}
      {% for link in mobile_secondary_links %}
        <a href="{{ link.url }}" class="mobile-nav-link" style="font-size:var(--text-xl);color:var(--color-text-muted);">{{ link.title }}</a>
      {% endfor %}
    </div>
  </nav>

  <!-- Cart Overlay -->
  <div id="cart-overlay" class="cart-overlay" aria-hidden="true"></div>

  <!-- Cart Drawer -->
  {% render 'cart-drawer' %}

  <!-- Predictive Search Overlay (respects enable_predictive_search setting) -->
  {% if settings.enable_predictive_search %}
    {% render 'search-drawer' %}
  {% endif %}

  <!-- Main Content -->
  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Site Footer -->
  {% section 'footer' %}

  <!-- Toast Notifications (injected by JS) -->

  <!-- Theme Runtime Config (native Shopify money format, routes & settings) -->
  <script>
    window.HorusTheme = {
      moneyFormat: {{ shop.money_format | json }},
      cartType: {{ settings.cart_type | default: 'drawer' | json }},
      freeShippingThreshold: {{ settings.free_shipping_threshold | default: 0 | times: 100 | json }},
      enablePredictiveSearch: {{ settings.enable_predictive_search | default: false | json }},
      routes: {
        cartUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        cartChangeUrl: {{ routes.cart_change_url | json }},
        cartUpdateUrl: {{ routes.cart_update_url | json }},
        allProductsUrl: {{ routes.all_products_collection_url | json }},
        searchUrl: {{ routes.search_url | json }},
        predictiveSearchUrl: {{ routes.predictive_search_url | json }}
      },
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        inStock: {{ 'products.product.in_stock' | t | json }},
        outOfStock: {{ 'products.product.out_of_stock' | t | json }},
        remove: {{ 'general.cart.remove' | t | json }},
        continueShopping: {{ 'general.cart.continue_shopping' | t | json }},
        cartEmpty: {{ 'general.cart.empty' | t | json }},
        cartEmptySubtitle: {{ 'general.cart.empty_subtitle' | t | json }},
        decreaseQuantity: {{ 'general.cart.decrease_quantity' | t | json }},
        increaseQuantity: {{ 'general.cart.increase_quantity' | t | json }},
        freeShippingUnlocked: {{ 'general.cart.free_shipping_unlocked' | t | json }},
        linkCopied: {{ 'products.product.link_copied' | t | json }},
        searchLoading: {{ 'general.search.loading' | t | json }},
        searchError: {{ 'general.search.error' | t | json }},
        searchProducts: {{ 'general.search.products' | t | json }},
        searchCollections: {{ 'general.search.collections' | t | json }},
        searchNoImage: {{ 'products.product.no_image' | t | json }},
        newsletterInvalidEmail: {{ 'general.newsletter.invalid_email' | t | json }}
      }
    };
  </script>

  <!-- Theme JS -->
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  <!-- Shopify analytics / checkout JS -->
  {% if settings.enable_predictive_search %}
    <script>
      window.HorusPredictiveSearch = {
        resources: {
          type: ['product', 'collection'],
          limit: 4,
          options: { unavailable_products: 'last', fields: ['title', 'product_type', 'variants.title', 'vendor'] }
        }
      };
    </script>
  {% endif %}

</body>
</html>
