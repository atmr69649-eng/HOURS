{% comment %}
  snippets/product-card.liquid
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- liquid
  assign featured_img   = product.featured_image
  assign hover_img      = product.images[1]
  assign current_variant = product.selected_or_first_available_variant
  assign is_on_sale     = false
  if current_variant.compare_at_price > current_variant.price
    assign is_on_sale = true
  endif
  assign is_new = false
  for tag in product.tags
    if tag == 'new' or tag == 'new-arrival'
      assign is_new = true
    endif
  endfor
  assign is_unisex = false
  for tag in product.tags
    if tag == 'unisex'
      assign is_unisex = true
    endif
  endfor
  assign is_limited = false
  for tag in product.tags
    if tag == 'limited' or tag == 'limited-edition'
      assign is_limited = true
    endif
  endfor

  # Pre-compute alt text: filters cannot be nested inside image_tag arguments
  assign featured_alt = featured_img.alt | default: product.title | escape
  assign hover_alt = hover_img.alt | default: product.title | escape

  # Detect Color/Colour option for swatch & variant coordination
  assign color_option = nil
  assign color_option_index = nil
  for option in product.options
    assign option_name = option.name | default: option | downcase
    if option_name == 'color' or option_name == 'colour'
      assign color_option_index = forloop.index0
      assign color_option = option
      break
    endif
  endfor
  assign active_color = nil
  assign is_color_only = false
  if color_option != nil
    assign active_color = current_variant.options[color_option_index]
    if product.options.size == 1
      assign is_color_only = true
    endif
  endif
-%}

<article class="product-card" aria-label="{{ product.title | escape }}">

  <!-- Image Wrapper (div so that interactive controls are not nested inside the link) -->
  <div class="card-image-wrap">

  <!-- Image Link -->
  <a
    href="{{ product.url }}"
    class="card-image-link"
    aria-label="View {{ product.title | escape }}"
    tabindex="-1">

    <!-- Primary Image -->
    {% if featured_img %}
      {{
        featured_img
        | image_url: width: 600
        | image_tag:
          class: 'card-img',
          alt: featured_alt,
          width: 600,
          height: 800,
          loading: 'lazy',
          widths: '300, 450, 600',
          sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw'
      }}
    {% else %}
      <div style="width:100%;height:100%;background:var(--color-surface-2);display:flex;align-items:center;justify-content:center;">
        <span style="color:var(--color-text-disabled);font-size:var(--text-xs);letter-spacing:0.1em;">NO IMAGE</span>
      </div>
    {% endif %}

    <!-- Hover / Second Image -->
    {% if hover_img %}
      {{
        hover_img
        | image_url: width: 600
        | image_tag:
          class: 'card-img-hover',
          alt: hover_alt,
          width: 600,
          height: 800,
          loading: 'lazy',
          aria-hidden: 'true'
      }}
    {% endif %}
  </a>

    <!-- Badges -->
    <div class="card-badges" aria-label="Product badges">
      {% if is_new %}
        <span class="card-badge card-badge-new" aria-label="New arrival">NEW</span>
      {% endif %}
      {% if is_on_sale %}
        {%- assign discount = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
        <span class="card-badge card-badge-sale" aria-label="{{ discount }}% off">-{{ discount }}%</span>
      {% endif %}
      {% if is_limited %}
        <span class="card-badge card-badge-limited" aria-label="Limited edition">LIMITED</span>
      {% endif %}
      {% if is_unisex %}
        <span class="card-badge card-badge-unisex" aria-label="Unisex">
          {% render 'icon-unisex' %} UNISEX
        </span>
      {% endif %}
    </div>

    <!-- Wishlist -->
    <button
      type="button"
      class="card-wishlist"
      aria-label="Add {{ product.title | escape }} to wishlist"
      data-wishlist-product="{{ product.id }}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
      </svg>
    </button>

    <!-- Quick Add (hover on desktop, always visible on touch) -->
    <div class="card-quick-add" aria-label="Quick add options">
      <!-- Size / Variant Pills (omitted for default-only and color-only products) -->
      {% unless product.has_only_default_variant or is_color_only %}
        <div class="quick-add-sizes" role="group" aria-label="Select option">
          {% for variant in product.variants %}
            {%- liquid
              assign pill_label = variant.title
              if product.options.size > 1 and color_option_index != nil
                assign non_color_parts = ''
                for opt_val in variant.options
                  if forloop.index0 != color_option_index
                    if non_color_parts != ''
                      assign non_color_parts = non_color_parts | append: ' / '
                    endif
                    assign non_color_parts = non_color_parts | append: opt_val
                  endif
                endfor
                if non_color_parts != ''
                  assign pill_label = non_color_parts
                endif
              endif
              assign variant_color_handle = ''
              assign hide_for_color = false
              if color_option != nil
                assign variant_color = variant.options[color_option_index]
                assign variant_color_handle = variant_color | handle
                if active_color != blank and variant_color != active_color
                  assign hide_for_color = true
                endif
              endif
            -%}
            {% if variant.available %}
              <button
                type="button"
                class="size-pill {% if variant.id == current_variant.id %}selected{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-variant-price="{{ variant.price }}"
                {% if variant.compare_at_price > variant.price %}data-variant-compare="{{ variant.compare_at_price }}"{% endif %}
                {% if variant_color_handle != blank %}data-option-color="{{ variant_color_handle }}"{% endif %}
                {% if hide_for_color %}hidden{% endif %}
                aria-label="{{ variant.title | escape }}"
                aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}">
                {{ pill_label }}
              </button>
            {% else %}
              <button
                type="button"
                class="size-pill unavailable"
                data-variant-id="{{ variant.id }}"
                data-variant-price="{{ variant.price }}"
                {% if variant.compare_at_price > variant.price %}data-variant-compare="{{ variant.compare_at_price }}"{% endif %}
                {% if variant_color_handle != blank %}data-option-color="{{ variant_color_handle }}"{% endif %}
                {% if hide_for_color %}hidden{% endif %}
                aria-label="{{ variant.title | escape }} — sold out"
                disabled>
                {{ pill_label }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endunless %}

      <button
        type="button"
        class="btn btn-gold btn-full card-add-btn"
        data-add-to-cart
        data-variant-id="{{ current_variant.id }}"
        {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
        aria-label="Add {{ product.title | escape }} to cart">
        <span class="btn-text">
          {% if current_variant.available %}
            {{ 'products.product.add_to_cart' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </span>
      </button>
    </div>

  </div>

  <!-- Card Info -->
  <div class="card-info">

    <!-- Color Swatches -->
    {% if color_option %}
      <div class="card-swatches" aria-label="Available colours" role="group">
        {% assign colors_shown = '|' %}
        {% for variant in product.variants %}
          {% assign this_color = variant.options[color_option_index] %}
          {% assign color_token = '|' | append: this_color | append: '|' %}
          {% unless colors_shown contains color_token %}
            {% assign colors_shown = colors_shown | append: this_color | append: '|' %}
            {% assign is_active_color = false %}
            {% if this_color == active_color %}
              {% assign is_active_color = true %}
            {% endif %}
            <button
              type="button"
              class="swatch {% if is_active_color %}active{% endif %}"
              style="background-color: {{ this_color | handle | replace: '-', '' }}; background-color: var(--swatch-{{ this_color | handle | replace: '-', '' }}, {{ this_color | downcase }});"
              aria-label="{{ this_color | escape }}"
              aria-pressed="{% if is_active_color %}true{% else %}false{% endif %}"
              data-color="{{ this_color | handle }}"
              data-variant-id="{{ variant.id }}"
              data-variant-available="{{ variant.available }}"
              data-variant-price="{{ variant.price }}"
              {% if variant.compare_at_price > variant.price %}data-variant-compare="{{ variant.compare_at_price }}"{% endif %}
              {% if variant.featured_image %}data-variant-img="{{ variant.featured_image | image_url: width: 600 }}"{% endif %}>
            </button>
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}

    <a href="{{ product.url }}" class="card-title" aria-label="{{ product.title }}">
      {{ product.title }}
    </a>

    <div class="card-meta">
      <div class="card-price-wrap" aria-label="Price">
        <span class="card-price">
          {{ current_variant.price | money }}
        </span>
        <span
          class="card-price-compare"
          {% unless is_on_sale %}hidden{% endunless %}
          {% if is_on_sale %}aria-label="Was {{ current_variant.compare_at_price | money }}"{% endif %}>
          {% if is_on_sale %}{{ current_variant.compare_at_price | money }}{% endif %}
        </span>
      </div>

      {% if product.variants.size > 1 %}
        <span class="text-muted text-xs">{{ product.variants.size }} styles</span>
      {% endif %}
    </div>

  </div>

</article>
